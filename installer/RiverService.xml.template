<service>
  <id>River</id>
  <name>River Helpdesk</name>
  <description>River Helpdesk application server</description>

  <depend>RiverMongoDB</depend>

  <executable>%BASE%\server\node.exe</executable>
  <arguments>%BASE%\server\dist\server.js</arguments>
  <workingdirectory>%BASE%\server</workingdirectory>

  <env name="NODE_ENV" value="production"/>
  <env name="PORT" value="5000"/>
  <env name="DOTENV_CONFIG_PATH" value="__RIVER_CONFIG_PATH__"/>

  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
</service>
